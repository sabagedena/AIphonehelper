# ============================================================
#  GEORGIAN AI VOICE HELPER & PHONE ASSISTANT (.env.example)
# ============================================================

# 1. Listening (Georgian Speech-to-Text) - Free key at https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3

# 2. Thinking (AI Brain) - Free key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# 3. Speaking (Native Georgian Voice - 100% Free Edge Neural)
TTS_PROVIDER=edge
EDGE_TTS_VOICE=ka-GE-EkaNeural
EDGE_TTS_RATE=+12%
EDGE_TTS_PITCH=+0Hz

# 4. Georgian Phone Line - MyPhone.ge SIP (+995 32 2XX XX XX)
MYPHONE_SIP_SERVER=89.150.1.11
MYPHONE_SIP_PORT=5060
MYPHONE_SIP_USERNAME=your_myphone_sip_username
MYPHONE_SIP_PASSWORD=your_myphone_sip_password
MYPHONE_PHONE_NUMBER=+995322195820

# Optional Claude (Anthropic) override
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5

# Server Ports
PORT=8000
HOST=0.0.0.0
